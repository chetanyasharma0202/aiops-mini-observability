{
  "uid": "aiops-mini-overview",
  "title": "AIOps Mini - Service Health",
  "tags": [
    "observability",
    "aiops",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest Request Latency (seconds)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "demo_request_latency_seconds",
          "legendFormat": "latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Simulated CPU Usage (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "demo_cpu_usage_percent",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "demo_http_error_ratio",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "AIOps Anomaly Flag (1 = anomaly)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "aiops_anomaly_detected",
          "legendFormat": "anomaly",
          "refId": "A"
        }
      ]
    }
  ]
}
